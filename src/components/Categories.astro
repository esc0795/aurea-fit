---
// src/components/Categories.astro
import { dataProvider, type Category } from '../lib/pocketbase';

interface Props {
  categories?: Category[];
}

const baseUrl = import.meta.env.BASE_URL;

let categoriesList: Category[] = Astro.props.categories || [];
if (!categoriesList || categoriesList.length === 0) {
  try {
    categoriesList = await dataProvider.getCategories();
  } catch (e) {
    console.error('Error cargando categorias en Categories.astro:', e);
  }
}

// Category design metadata map for tailored presentation
const categoryMetaMap: Record<string, { image: string; tag: string; tagClass: string; subtitle: string }> = {
  leggings: {
    image: `${baseUrl}images/cat-seamless-leggings.jpg`,
    tag: '100% SQUAT-PROOF',
    tagClass: 'luxury-tag-dark',
    subtitle: 'Cintura Alta & Efecto Glute-Sculpt'
  },
  bras: {
    image: `${baseUrl}images/cat-sports-bras.jpg`,
    tag: 'MEDIUM & HIGH SUPPORT',
    tagClass: 'luxury-tag-gold',
    subtitle: 'Soporte Ergonómico & Acabado Seamless'
  },
  shorts: {
    image: `${baseUrl}images/cat-sculpt-shorts.jpg`,
    tag: 'BOOTY CONTOUR',
    tagClass: 'luxury-tag-dark',
    subtitle: 'Efecto Booty Contour & Ajuste Anatómico'
  },
  accesorios: {
    image: `${baseUrl}images/cat-accessories.jpg`,
    tag: 'ATHLEISURE GEAR',
    tagClass: 'luxury-tag-gold',
    subtitle: 'Cintas Elásticas para el Cabello & Leg Warmers'
  }
};
---

<section id="explorar-tienda" class="categories-section">
  <div class="container">
    
    <!-- Section Header aligned with Aurea Fit luxury aesthetic -->
    <div class="section-header">
      <div class="header-left">
        <span class="luxury-tag luxury-tag-gold">EXPLORAR TIENDA</span>
        <h2 class="section-title">
          DESCUBRE NUESTRAS <span class="highlight-title">COLECCIONES</span>
        </h2>
      </div>
      <p class="section-intro">
        Cada diseño está pensado para ajustarse anatómicamente a tu cuerpo, brindándote soporte ergonómico, tejido 100% squat-proof y libertad absoluta para entrenar.
      </p>
    </div>

    <!-- Category Cards Grid (Scalable dynamically with PocketBase) -->
    <div class="category-grid">
      {categoriesList.map((cat) => {
        const slugKey = cat.slug?.toLowerCase().includes('bra') || cat.name?.toLowerCase().includes('bra')
          ? 'bras'
          : cat.slug?.toLowerCase().includes('legging') || cat.name?.toLowerCase().includes('legging')
          ? 'leggings'
          : cat.slug?.toLowerCase().includes('short') || cat.name?.toLowerCase().includes('short')
          ? 'shorts'
          : cat.slug?.toLowerCase().includes('accesorio') || cat.name?.toLowerCase().includes('accesorio')
          ? 'accesorios'
          : cat.slug;

        const meta = categoryMetaMap[slugKey] || {
          image: `${baseUrl}images/cat-sports-bras.jpg`,
          tag: 'NUEVA COLECCIÓN',
          tagClass: 'luxury-tag-gold',
          subtitle: 'Colección Aurea Fit'
        };
        const categoryUrl = `${baseUrl}categoria/${encodeURIComponent(cat.slug)}`;

        return (
          <div class="category-card">
            
            <a href={categoryUrl} class="card-media-link" aria-label={`Ver colección ${cat.name}`}>
              <div class="card-media">
                <img src={meta.image} alt={cat.name} class="card-image" loading="lazy" />
                <div class="card-scrim"></div>
              </div>
            </a>

            <div class="card-tag-wrapper">
              <span class={`luxury-tag ${meta.tagClass}`}>
                {meta.tag}
              </span>
            </div>

            <div class="card-bottom">
              <span class="card-sub">{meta.subtitle}</span>
              <h3 class="card-name">
                <a href={categoryUrl}>{cat.name}</a>
              </h3>
              
              <a 
                href={categoryUrl} 
                class="btn-card-explore"
                aria-label={`Ver detalles de ${cat.name}`}
              >
                <span>VER DETALLES</span>
                <svg class="icon-arrow-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  .categories-section {
    padding: 90px 0 80px;
    background-color: var(--bg-white);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 50px;
  }

  @media (min-width: 860px) {
    .section-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .section-title {
    font-size: clamp(2rem, 3.4vw, 3rem);
    color: var(--text-primary);
    line-height: 1.08;
    letter-spacing: 0.02em;
  }

  .highlight-title {
    color: var(--accent-taupe);
  }

  .section-intro {
    font-size: 1.04rem;
    color: var(--text-secondary);
    max-width: 480px;
    line-height: 1.65;
  }

  /* Grid */
  .category-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 600px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }
  }

  @media (min-width: 1024px) {
    .category-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  /* Category Card */
  .category-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--bg-sand);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  @media (max-width: 600px) {
    .category-card {
      height: 480px;
    }
  }

  .category-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
  }

  .card-media-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    text-decoration: none;
  }

  .card-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .category-card:hover .card-image {
    transform: scale(1.06);
  }

  .card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.05) 40%,
      rgba(0, 0, 0, 0.65) 80%,
      rgba(0, 0, 0, 0.88) 100%
    );
    transition: background 0.3s ease;
  }

  .category-card:hover .card-scrim {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.02) 40%,
      rgba(0, 0, 0, 0.72) 80%,
      rgba(0, 0, 0, 0.92) 100%
    );
  }

  /* Tag */
  .card-tag-wrapper {
    position: relative;
    z-index: 2;
    padding: 20px;
    pointer-events: none;
  }

  /* Bottom Content */
  .card-bottom {
    position: relative;
    z-index: 2;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-sub {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-champagne);
    text-transform: uppercase;
  }

  .card-name {
    font-size: 1.35rem;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .card-name a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-name a:hover {
    color: var(--accent-champagne);
  }

  .btn-card-explore {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    color: var(--text-primary);
    padding: 13px 24px;
    border-radius: var(--radius-full, 9999px);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
  }

  .icon-arrow-sm {
    width: 16px;
    height: 16px;
    transition: transform 0.25s ease;
  }

  .category-card:hover .btn-card-explore {
    background: #121214;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
  }

  .category-card:hover .icon-arrow-sm {
    transform: translateX(4px);
  }
</style>

---
// src/components/CartDrawer.astro
const baseUrl = import.meta.env.BASE_URL;
---

<div id="cart-drawer-overlay" class="cart-drawer-overlay" aria-hidden="true"></div>

<aside id="cart-drawer" class="cart-drawer" aria-label="Bolsa de compras" aria-hidden="true">
  <div class="cart-drawer-header">
    <div class="cart-title-wrap">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      <h2 class="cart-title">TU BOLSA DE COMPRAS</h2>
      <span id="cart-drawer-total-count" class="cart-badge">0</span>
    </div>
    <button id="close-cart-btn" class="close-cart-btn" aria-label="Cerrar bolsa">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Cart Body -->
  <div id="cart-drawer-body" class="cart-drawer-body">
    <!-- Populated by JavaScript -->
    <div class="cart-empty-state">
      <div class="empty-cart-icon">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </div>
      <p class="empty-cart-msg">Tu bolsa de compras está vacía.</p>
      <a href={`${baseUrl}#categorias`} class="btn-continue-shopping" id="btn-empty-shop">
        <span>Explorar tienda</span>
      </a>
    </div>
  </div>

  <!-- Cart Footer -->
  <div id="cart-drawer-footer" class="cart-drawer-footer hidden">
    <div class="cart-subtotal-row">
      <span class="subtotal-label">Subtotal estimado:</span>
      <span id="cart-drawer-subtotal" class="subtotal-val">₡0</span>
    </div>
    <p class="shipping-hint">Envíos a todo Costa Rica por Correos de Costa Rica.</p>
    
    <div class="cart-footer-actions">
      <!-- Direct WhatsApp Checkout -->
      <a id="btn-cart-whatsapp" href="#" target="_blank" rel="noopener noreferrer" class="btn-checkout-wa">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.179.182-.077.357.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.174.231-.145.39-.087s1.011.477 1.184.564c.173.087.289.13.332.203.043.072.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.966-1.393A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        <span>Comprar</span>
      </a>

      <!-- Clear cart -->
      <button id="btn-clear-cart" type="button" class="btn-clear-cart">
        Vaciar bolsa
      </button>
    </div>
  </div>
</aside>

<script>
  import { getCart, removeFromCart, updateQuantity, clearCart, getCartTotal, getCartCount, type CartItem } from '../lib/cart';

  const drawer = document.getElementById('cart-drawer');
  const overlay = document.getElementById('cart-drawer-overlay');
  const closeBtn = document.getElementById('close-cart-btn');
  const emptyShopBtn = document.getElementById('btn-empty-shop');
  const bodyEl = document.getElementById('cart-drawer-body');
  const footerEl = document.getElementById('cart-drawer-footer');
  const totalCountEl = document.getElementById('cart-drawer-total-count');
  const subtotalEl = document.getElementById('cart-drawer-subtotal');
  const checkoutWaBtn = document.getElementById('btn-cart-whatsapp') as HTMLAnchorElement | null;
  const clearBtn = document.getElementById('btn-clear-cart');

  function openCart() {
    if (!drawer || !overlay) return;
    drawer.classList.add('open');
    overlay.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    renderCart();
  }

  function closeCart() {
    if (!drawer || !overlay) return;
    drawer.classList.remove('open');
    overlay.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Update header cart count badges
  function updateHeaderCount(count: number) {
    document.querySelectorAll('.cart-count').forEach((badge) => {
      badge.textContent = String(count);
    });
  }

  function renderCart() {
    const items = getCart();
    const count = getCartCount();
    const total = getCartTotal();

    updateHeaderCount(count);

    if (totalCountEl) totalCountEl.textContent = String(count);
    if (subtotalEl) subtotalEl.textContent = `₡${total.toLocaleString('es-CR')}`;

    if (!bodyEl || !footerEl) return;

    if (items.length === 0) {
      footerEl.classList.add('hidden');
      bodyEl.innerHTML = `
        <div class="cart-empty-state">
          <div class="empty-cart-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
          </div>
          <p class="empty-cart-msg">Tu bolsa de compras está vacía.</p>
          <button type="button" class="btn-continue-shopping" id="btn-empty-shop-close">
            <span>Explorar tienda</span>
          </button>
        </div>
      `;
      document.getElementById('btn-empty-shop-close')?.addEventListener('click', closeCart);
      return;
    }

    footerEl.classList.remove('hidden');

    // Build items HTML
    bodyEl.innerHTML = `
      <ul class="cart-items-list">
        ${items.map((item) => `
          <li class="cart-item" data-id="${item.id}">
            <img src="${item.image}" alt="${item.name}" class="cart-item-img" />
            <div class="cart-item-info">
              <h4 class="cart-item-name">${item.name}</h4>
              <div class="cart-item-meta">
                <span class="cart-item-size">Talla: <strong>${item.size}</strong></span>
                <span class="cart-item-price">₡${Number(item.price).toLocaleString('es-CR')}</span>
              </div>
              <div class="cart-item-actions">
                <div class="qty-control">
                  <button type="button" class="btn-qty-minus" data-id="${item.id}" aria-label="Disminuir cantidad">-</button>
                  <span class="qty-val">${item.quantity}</span>
                  <button type="button" class="btn-qty-plus" data-id="${item.id}" aria-label="Aumentar cantidad">+</button>
                </div>
                <button type="button" class="btn-remove-item" data-id="${item.id}" aria-label="Eliminar producto">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                  <span>Eliminar</span>
                </button>
              </div>
            </div>
          </li>
        `).join('')}
      </ul>
    `;

    // Hook listeners for qty minus, plus, remove
    bodyEl.querySelectorAll<HTMLButtonElement>('.btn-qty-minus').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (id) {
          const it = items.find((x) => x.id === id);
          if (it) updateQuantity(id, it.quantity - 1);
        }
      });
    });

    bodyEl.querySelectorAll<HTMLButtonElement>('.btn-qty-plus').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (id) {
          const it = items.find((x) => x.id === id);
          if (it) updateQuantity(id, it.quantity + 1);
        }
      });
    });

    bodyEl.querySelectorAll<HTMLButtonElement>('.btn-remove-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (id) removeFromCart(id);
      });
    });

    // Generate WhatsApp Checkout Message
    if (checkoutWaBtn) {
      const waPhone = '50688888888';
      let message = '¡Hola Aurea Fit! Deseo confirmar mi pedido desde la página web:\n\n';
      items.forEach((it, idx) => {
        message += `${idx + 1}. *${it.name}* (Talla: ${it.size}) x${it.quantity} - ₡${(it.price * it.quantity).toLocaleString('es-CR')}\n`;
      });
      message += `\n*Total a pagar: ₡${total.toLocaleString('es-CR')}*\n`;
      message += '\n¿Me podrían indicar los datos para coordinar el envío? ¡Muchas gracias!';
      checkoutWaBtn.href = `https://wa.me/${waPhone}?text=${encodeURIComponent(message)}`;
    }
  }

  // Clear cart button
  clearBtn?.addEventListener('click', () => {
    if (confirm('¿Estás seguro de que deseas vaciar tu bolsa de compras?')) {
      clearCart();
    }
  });

  // Global listeners
  closeBtn?.addEventListener('click', closeCart);
  overlay?.addEventListener('click', closeCart);
  emptyShopBtn?.addEventListener('click', closeCart);

  // Keyboard escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('open')) {
      closeCart();
    }
  });

  // Open cart triggers from anywhere
  document.querySelectorAll<HTMLElement>('.btn-cart-minimal, [data-open-cart]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openCart();
    });
  });

  // React to cart-updated event from other components
  window.addEventListener('cart-updated', () => {
    renderCart();
  });

  // Open cart request event
  window.addEventListener('open-cart', () => {
    openCart();
  });

  // Initial count sync
  updateHeaderCount(getCartCount());
</script>

<style>
  /* Drawer Overlay */
  .cart-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    z-index: 1050;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .cart-drawer-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Cart Drawer Panel */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 440px;
    background: #ffffff;
    z-index: 1060;
    display: flex;
    flex-direction: column;
    box-shadow: -8px 0 30px rgba(0, 0, 0, 0.15);
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cart-drawer.open {
    transform: translateX(0);
  }

  /* Header */
  .cart-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--border-light, rgba(0, 0, 0, 0.08));
    background: #ffffff;
  }

  .cart-title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cart-title {
    font-family: var(--font-display, 'Oswald', sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-primary, #121214);
    margin: 0;
  }

  .cart-badge {
    background: var(--text-primary, #121214);
    color: #ffffff;
    font-size: 0.74rem;
    font-weight: 700;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: var(--radius-full, 9999px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .close-cart-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--text-primary, #121214);
    background: transparent;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .close-cart-btn:hover {
    background: var(--bg-sand, #f5f2ec);
    transform: rotate(90deg);
  }

  /* Body */
  .cart-drawer-body {
    flex-grow: 1;
    overflow-y: auto;
    padding: 20px 24px;
  }

  /* Empty State */
  .cart-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    min-height: 280px;
    gap: 14px;
  }

  .empty-cart-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--bg-sand, #f5f2ec);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-taupe, #8f7967);
  }

  .empty-cart-msg {
    font-size: 1rem;
    color: var(--text-secondary, #4a4a52);
    margin-bottom: 6px;
  }

  .btn-continue-shopping {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    border-radius: var(--radius-full, 9999px);
    background: var(--text-primary, #121214);
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .btn-continue-shopping:hover {
    background: var(--accent-taupe, #8f7967);
    transform: translateY(-2px);
  }

  /* Items List */
  .cart-items-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cart-item {
    display: flex;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-light, rgba(0, 0, 0, 0.08));
    align-items: center;
  }

  .cart-item-img {
    width: 52px;
    height: 65px;
    object-fit: cover;
    border-radius: var(--radius-sm, 6px);
    background: var(--bg-sand, #f5f2ec);
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
  }

  .cart-item-info {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cart-item-name {
    font-family: var(--font-display, 'Oswald', sans-serif);
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--text-primary, #121214);
    text-transform: uppercase;
    line-height: 1.2;
    margin: 0;
  }

  .cart-item-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.84rem;
    color: var(--text-secondary, #4a4a52);
  }

  .cart-item-size strong {
    color: var(--text-primary, #121214);
  }

  .cart-item-price {
    font-weight: 800;
    color: var(--text-primary, #121214);
  }

  .cart-item-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
  }

  .qty-control {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border-medium, rgba(0, 0, 0, 0.16));
    border-radius: var(--radius-full, 9999px);
    overflow: hidden;
  }

  .qty-control button {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    font-weight: 700;
    color: var(--text-primary, #121214);
    transition: background 0.2s ease;
  }

  .qty-control button:hover {
    background: var(--bg-sand, #f5f2ec);
  }

  .qty-val {
    min-width: 24px;
    text-align: center;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .btn-remove-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    color: var(--text-muted, #767682);
    border: none;
    background: transparent;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .btn-remove-item:hover {
    color: #e11d48;
  }

  /* Footer */
  .cart-drawer-footer {
    padding: 20px 24px;
    border-top: 1px solid var(--border-light, rgba(0, 0, 0, 0.08));
    background: var(--bg-cream, #faf8f5);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cart-drawer-footer.hidden {
    display: none;
  }

  .cart-subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .subtotal-label {
    font-size: 0.92rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-secondary, #4a4a52);
  }

  .subtotal-val {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-primary, #121214);
  }

  .shipping-hint {
    font-size: 0.78rem;
    color: var(--text-muted, #767682);
  }

  .cart-footer-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .btn-checkout-wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px;
    border-radius: var(--radius-full, 9999px);
    background: linear-gradient(135deg, #1b6e3e 0%, #155731 100%);
    color: #ffffff;
    font-family: var(--font-body, sans-serif);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(27, 110, 62, 0.35);
    transition: all 0.25s ease;
  }

  .btn-checkout-wa:hover {
    background: linear-gradient(135deg, #1f7d46 0%, #176137 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(27, 110, 62, 0.45);
  }

  .btn-clear-cart {
    background: transparent;
    border: none;
    font-size: 0.8rem;
    color: var(--text-muted, #767682);
    cursor: pointer;
    text-align: center;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .btn-clear-cart:hover {
    color: var(--text-primary, #121214);
  }
</style>

---
// src/components/CategoryFilter.astro
import type { Category } from '../lib/pocketbase';

interface Props {
  categories: Category[];
  activeSlug?: string;
}

const { categories = [], activeSlug = 'all' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<nav class="category-filter-nav" aria-label="Filtro de categorías">
  <div class="category-pills-container">
    <!-- "Todos" Pill -->
    <a 
      href={`${baseUrl}`} 
      class:list={['filter-pill', { active: activeSlug === 'all' }]}
      aria-current={activeSlug === 'all' ? 'page' : undefined}
    >
      <span>Todos</span>
    </a>

    <!-- Category Specific Pills -->
    {categories.map((cat) => {
      const isSelected = activeSlug.toLowerCase() === cat.slug.toLowerCase();
      const href = `${baseUrl}categoria/${encodeURIComponent(cat.slug)}`;
      return (
        <a 
          href={href} 
          class:list={['filter-pill', { active: isSelected }]}
          aria-current={isSelected ? 'page' : undefined}
        >
          <span>{cat.name}</span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  .category-filter-nav {
    width: 100%;
    margin-bottom: 36px;
  }

  .category-pills-container {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    padding: 6px 2px;
  }

  @media (max-width: 640px) {
    .category-pills-container {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      padding-bottom: 12px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .category-pills-container::-webkit-scrollbar {
      display: none;
    }
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    border-radius: var(--radius-full, 9999px);
    font-family: var(--font-body, sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border: 1.5px solid var(--border-medium, rgba(0, 0, 0, 0.16));
    background-color: #ffffff;
    color: var(--text-primary, #121214);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    cursor: pointer;
  }

  .filter-pill:hover {
    border-color: #121214;
    background-color: var(--bg-sand, #f5f2ec);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
  }

  .filter-pill.active {
    background-color: #121214;
    color: #ffffff;
    border-color: #121214;
    box-shadow: 0 6px 18px rgba(18, 18, 20, 0.25);
    transform: translateY(-1px);
  }

  .filter-pill.active:hover {
    background-color: #26262a;
    border-color: #26262a;
  }
</style>

---
// src/components/CatalogPreview.astro

const products = [
  {
    id: 'prod-1',
    name: 'Aurea "Iron & Skull" Oversized Tee',
    category: 'Oversized Tees',
    price: '₡18,500',
    comparePrice: '₡22,000',
    tag: 'DROP 01 // BESTSELLER',
    tagType: 'cyan',
    image: '/images/cat-oversized.jpg',
    sizes: ['S', 'M', 'L', 'XL'],
    inStock: true
  },
  {
    id: 'prod-2',
    name: 'Aurea Pro Seamless High-Waist Leggings',
    category: 'Seamless Activewear',
    price: '₡22,000',
    comparePrice: null,
    tag: 'SQUAT PROOF',
    tagType: 'magenta',
    image: '/images/cat-leggings.jpg',
    sizes: ['XS', 'S', 'M', 'L'],
    inStock: true
  },
  {
    id: 'prod-3',
    name: 'Aurea Boxy Cut Heavyweight Pump Hoodie',
    category: 'Pump Covers',
    price: '₡28,500',
    comparePrice: '₡32,000',
    tag: 'ÚLTIMAS UNIDADES',
    tagType: 'magenta',
    image: '/images/cat-hoodies.jpg',
    sizes: ['M', 'L', 'XL'],
    inStock: true
  },
  {
    id: 'prod-4',
    name: 'Aurea Heavy-Duty Lifting Straps & Duffle',
    category: 'Accesorios & Gear',
    price: '₡12,000',
    comparePrice: null,
    tag: 'ESSENTIALS',
    tagType: 'cyan',
    image: '/images/cat-accessories.jpg',
    sizes: ['ÚNICA'],
    inStock: true
  }
];
---

<section id="catalogo" class="catalog-section">
  <div class="container">
    
    <!-- Section Title & Tabs -->
    <div class="catalog-header">
      <div>
        <span class="cyber-tag cyber-tag-magenta">TIENDA Y NOVEDADES</span>
        <h2 class="catalog-title">
          DROP 01 // <span class="text-gradient-cyan">PRENDAS DESTACADAS</span>
        </h2>
      </div>

      <div class="filter-tabs">
        <button class="tab-btn active" data-filter="all">TODOS</button>
        <button class="tab-btn" data-filter="oversized">OVERSIZED</button>
        <button class="tab-btn" data-filter="seamless">SEAMLESS</button>
        <button class="tab-btn" data-filter="gear">ACCESORIOS</button>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="product-grid">
      {products.map((product) => (
        <div class="product-card" data-category={product.category.toLowerCase()}>
          
          <!-- Media & Badges -->
          <div class="product-media">
            <img src={product.image} alt={product.name} class="product-img" loading="lazy" />
            <div class="product-badge">
              <span class={`cyber-tag ${product.tagType === 'magenta' ? 'cyber-tag-magenta' : ''}`}>
                {product.tag}
              </span>
            </div>
            
            <a 
              href={`https://wa.me/50688888888?text=Hola%20Aurea%20Fit,%20me%20interesa%20la%20prenda:%20${encodeURIComponent(product.name)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="quick-wa-btn"
              title="Pedir por WhatsApp"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.179.182-.077.357.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.174.231-.145.39-.087s1.011.477 1.184.564c.173.087.289.13.332.203.043.072.043.419-.101.824zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.966-1.393A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
              </svg>
              <span>PEDIR EN WHATSAPP</span>
            </a>
          </div>

          <!-- Info -->
          <div class="product-details">
            <span class="product-cat">{product.category}</span>
            <h3 class="product-title">{product.name}</h3>
            
            <!-- Sizes -->
            <div class="product-sizes">
              <span class="sizes-label">Tallas:</span>
              <div class="size-chips">
                {product.sizes.map((size) => (
                  <span class="size-chip">{size}</span>
                ))}
              </div>
            </div>

            <!-- Price & Action -->
            <div class="product-pricing-row">
              <div class="price-wrap">
                <span class="current-price">{product.price}</span>
                {product.comparePrice && (
                  <span class="compare-price">{product.comparePrice}</span>
                )}
              </div>
              
              <button class="btn-add-bag" title="Consultar prenda">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
              </button>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .catalog-section {
    padding: 80px 0;
    background-color: var(--bg-surface);
  }

  .catalog-header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
  }

  @media (min-width: 768px) {
    .catalog-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .catalog-title {
    font-size: clamp(1.8rem, 3.2vw, 2.8rem);
    color: #ffffff;
    line-height: 1.1;
    margin-top: 8px;
  }

  /* Filter Tabs */
  .filter-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .tab-btn {
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    padding: 8px 18px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .tab-btn.active {
    background: #ffffff;
    color: #08080a;
    border-color: #ffffff;
    font-weight: 700;
  }

  /* Grid */
  .product-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 600px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Product Card */
  .product-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-card:hover {
    border-color: rgba(0, 240, 255, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6), 0 0 16px rgba(0, 240, 255, 0.2);
  }

  .product-media {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #000;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.05);
  }

  .product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
  }

  .quick-wa-btn {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: rgba(37, 211, 102, 0.95);
    color: #050505;
    padding: 10px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.25s ease;
    z-index: 3;
  }

  .quick-wa-btn svg {
    width: 16px;
    height: 16px;
  }

  .product-card:hover .quick-wa-btn {
    opacity: 1;
    transform: translateY(0);
  }

  /* Details */
  .product-details {
    padding: 18px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .product-cat {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .product-title {
    font-size: 1.15rem;
    color: #ffffff;
    line-height: 1.25;
    margin: 4px 0 12px;
    min-height: 42px;
  }

  .product-sizes {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .sizes-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .size-chips {
    display: flex;
    gap: 4px;
  }

  .size-chip {
    font-family: var(--font-tech);
    font-size: 0.65rem;
    padding: 2px 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    color: var(--text-muted);
  }

  .product-pricing-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .price-wrap {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .current-price {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
  }

  .compare-price {
    font-size: 0.85rem;
    color: var(--text-dim);
    text-decoration: line-through;
  }

  .btn-add-bag {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .btn-add-bag svg {
    width: 18px;
    height: 18px;
  }

  .btn-add-bag:hover {
    background: var(--color-cyan);
    color: #000000;
    border-color: var(--color-cyan);
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.4);
  }
</style>
